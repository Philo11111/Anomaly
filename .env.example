# ===== TELEGRAM BOT =====
BOT_TOKEN=7xxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_CHAT_ID=123456789

# ===== AI — вибери один варіант =====
# Варіант 1: Anthropic (~$1-3/міс)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Варіант 2: OpenRouter з Gemini Flash (БЕЗКОШТОВНО)
# Залиш ANTHROPIC_API_KEY порожнім
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ===== TELETHON =====
# Отримай API_ID та API_HASH на https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TELEGRAM_SESSION — довгий рядок що генерує tools/create_session.py
# Після генерації вставляєш сюди або в Railway Variables
# Телефон після цього не потрібен
TELEGRAM_SESSION=

# Потрібен ТІЛЬКИ для запуску create_session.py (один раз локально)
TELEGRAM_PHONE=+380XXXXXXXXX

# ===== ON-CHAIN APIs (безкоштовно) =====
ETHERSCAN_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SOLSCAN_API_KEY=

# ===== НАЛАШТУВАННЯ =====
PRICE_CHANGE_THRESHOLD=4.0
TVL_DROP_THRESHOLD=8.0
MIN_AI_SCORE=6
WHALE_TX_USD=1000000
RSS_CHECK_INTERVAL=90
TVL_CHECK_INTERVAL=180
ONCHAIN_CHECK_INTERVAL=60
