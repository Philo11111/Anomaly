# Secrets stay here or in the process environment. Never commit a filled-in .env.
# The service starts with every value empty. Telegram is optional.

# JSON webhook for red alerts. Leave empty to keep only logs, JSONL and the dashboard.
WEBHOOK_URL=

# Optional dashboard lock. /health stays open for Railway.
DASHBOARD_TOKEN=

# Local dashboard bind. Railway and Docker should use 0.0.0.0.
DASHBOARD_HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Telegram bot delivery. Both are required before red alerts are pushed to a chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telethon listener. Create the session string once with tools/create_session.py.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_PHONE=
